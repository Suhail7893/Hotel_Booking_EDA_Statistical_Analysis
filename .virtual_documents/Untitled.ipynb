display(monthly_bookings)

print("Highest booking month:", monthly_bookings.idxmax())
print("Lowest booking month:", monthly_bookings.idxmin())


print("Average ADR:", round(df_clean["adr"].mean(), 2))
print("Median ADR:", round(df_clean["adr"].median(), 2))
print("Minimum ADR:", round(df_clean["adr"].min(), 2))
print("Maximum ADR:", round(df_clean["adr"].max(), 2))

adr_by_hotel = df_clean.groupby("hotel")["adr"].mean()

display(adr_by_hotel)


market_analysis = df_clean["market_segment"].value_counts()

market_percentage = (
    df_clean["market_segment"].value_counts(normalize=True) * 100
)

display(market_analysis)
display(market_percentage.round(2))


customer_analysis = df_clean["customer_type"].value_counts()

display(customer_analysis)


hotel_cancellation = pd.crosstab(
