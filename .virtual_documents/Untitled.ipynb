cancellation_rate = df_clean["is_canceled"].mean() * 100

print("Cancellation counts:")
display(cancellation_counts)

print("Cancellation rate:", round(cancellation_rate, 2), "%")


months = [
    "January", "February", "March", "April",
    "May", "June", "July", "August",
