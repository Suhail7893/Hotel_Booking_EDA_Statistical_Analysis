        dataset_path = os.path.join(root, "hotel_bookings.csv")
        break

if dataset_path:
    print("Dataset found:", dataset_path)

    df = pd.read_csv(dataset_path)

    print("Dataset loaded successfully!")
    print("Dataset shape:", df.shape)

    display(df.head())
else:
    print("Dataset not found!")
